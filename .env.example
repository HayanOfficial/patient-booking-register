# ==============================================================================
# PATIENT BOOKING REGISTER (HIMS FRONT-DESK)
# Environment Configuration Template for Local Development & Vercel Production
# ==============================================================================

# 1. Supabase Project URL
# Found in: Supabase Dashboard -> Project Settings -> Configuration -> API -> Project URL
# Example: https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anonymous Public Key
# Found in: Supabase Dashboard -> Project Settings -> Configuration -> API -> Project API Keys -> anon (public)
# Safe to expose to the browser; used by Supabase JS client for queries & Realtime channels
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 3. Supabase Service Role Key (SERVER-ONLY)
# Found in: Supabase Dashboard -> Project Settings -> Configuration -> API -> Project API Keys -> service_role (secret)
# IMPORTANT: Never prefix with NEXT_PUBLIC_. Only used in backend / server-side administration.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# 4. Clinic Timezone Anchor
# Pakistan Standard Time (UTC+5:00)
NEXT_PUBLIC_APP_TIMEZONE=Asia/Karachi
